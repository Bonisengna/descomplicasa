    {
      "name": "CONFERIR INTEGRIDADE SNAPSHOT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Why Code: comparar hashes e prazo e restaurar pacote após nós que substituem JSON.\nconst p=$('VALIDAR SNAPSHOT RECUPERADO').first().json;\nif($json.checkedArticleHash!==p.versionHash||$json.checkedImageBase64Hash!==p.imageBase64Hash)throw new Error('Snapshot alterado após aprovação');\nif(Date.now()>=p.expiresAt||Date.now()-Date.parse(p.approval.approvedAt)>=86400000)throw new Error('Aprovação expirada');\nreturn [{json:p}];"
      },
      "position": [
        0,
        200
      ]
    },
