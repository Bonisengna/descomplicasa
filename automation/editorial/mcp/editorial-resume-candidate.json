              "name": "sourceWorkflowId",
              "type": "string",
              "value": "CONFIGURAR_WORKFLOW_ORIGEM"
            },
            {
              "id": "publish",
              "name": "publishEnabled",
              "type": "boolean",
              "value": false
            },
            {
