    {
      "name": "VALIDAR PAGINA PUBLICADA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const a=$('VALIDAR SNAPSHOT RECUPERADO').first().json.article;\nconst escaped=a.title.replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#x27;'}[c]));\nif(typeof $json.publicHtml!=='string'||!$json.publicHtml.includes(escaped))throw new Error('Título da página pública não confirmado');\nreturn [{json:$('VALIDAR RECIBO PUBLICACAO').first().json}];"
      },
      "position": [
