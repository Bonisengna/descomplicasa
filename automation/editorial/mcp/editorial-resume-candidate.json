    {
      "name": "HASH NATIVO - SNAPSHOT BASE64",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $('VALIDAR SNAPSHOT RECUPERADO').first().json.imageBase64 }}",
        "dataPropertyName": "checkedImageBase64Hash"
      },
