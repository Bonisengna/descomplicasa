        },
        "options": {}
      },
      "position": [
        240,
        0
      ]
    },
    {
      "name": "VALIDAR CHAVE CONFIGURADA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$json;const parts=String(c.snapshotKey||'').split(':');if(!/^[A-Za-z0-9_-]{1,100}$/.test(c.sourceWorkflowId)||parts.length!==3||parts[0]!==c.sourceWorkflowId||!/^\\d+$/.test(parts[1])||!/^[a-f0-9]{64}$/.test(parts[2]))throw new Error('Configure somente a chave de um snapshot aprovado existente');return [{json:c}];"
      },
      "position": [
        480,
        0
      ]
    },
    {
      "name": "LER SNAPSHOT APROVADO",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "CONFIGURAR_DATA_TABLE_ID",
          "cachedResultName": "Descomplicaza Editorial Approved Snapshots"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "snapshotKey",
              "condition": "eq",
              "keyValue": "={{ $json.snapshotKey }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 2
      },
      "position": [
        720,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "name": "VALIDAR SNAPSHOT RECUPERADO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Why Code: validar envelope persistido, identidade e prazo antes de restaurar o pacote aprovado.\nconst rows=$input.all(),c=$('CONFIGURAR RETOMADA').first().json;\nif(rows.length!==1||typeof rows[0].json.payloadJson!=='string')throw new Error('Snapshot ausente ou duplicado');\nconst r=rows[0].json;\nif(r.payloadJson.length>8000000||r.state!=='APPROVED'||r.snapshotKey!==c.snapshotKey||r.workflowId!==c.sourceWorkflowId)throw new Error('Snapshot não autorizado para retomada');\nconst p=JSON.parse(r.payloadJson),e=p.approvalEvidence||{},now=Date.now(),approvedAt=Date.parse(p.approval?.approvedAt);\nif(r.snapshotKey!==r.workflowId+':'+r.executionId+':'+p.versionHash||r.versionHash!==p.versionHash||r.imageBase64Hash!==p.imageBase64Hash||p.approval?.versionHash!==p.versionHash)throw new Error('Chave ou hashes de snapshot inconsistentes');\nif(!/^[a-f0-9]{64}$/.test(p.versionHash)||!/^[a-f0-9]{64}$/.test(p.imageBase64Hash)||!Number.isInteger(r.revision)||r.revision<1||!/^[A-Za-z0-9_-]{1,100}$/.test(r.itemId))throw new Error('Contrato de snapshot inválido');\nif(p.approved!==true||p.decision!=='APROVADO'||e.approved!==true||e.responder?.source!=='telegram'||String(e.responder?.id)!==String(c.telegramUserId)||String(e.chatId)!==String(c.chatId)||String(p.approval.approvedBy)!==String(c.telegramUserId)||String(r.approvedBy)!==String(c.telegramUserId))throw new Error('Identidade Telegram divergente');\nif(!Number.isFinite(p.createdAt)||!Number.isFinite(p.expiresAt)||p.createdAt>now+60000||p.expiresAt>p.createdAt+86400000||p.expiresAt<=p.createdAt||now>=p.expiresAt||Date.parse(r.expiresAt)!==p.expiresAt||!Number.isFinite(approvedAt)||approvedAt<p.createdAt-60000||approvedAt>now+60000||now-approvedAt>=86400000||Date.parse(r.approvedAt)!==approvedAt)throw new Error('Aprovação expirada ou datas inconsistentes');\nif(typeof p.imageBase64!=='string'||p.imageBase64.length>7000000||p.imageMimeType!=='image/jpeg'||!p.article||typeof p.article.slug!=='string'||!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(p.article.slug))throw new Error('Pacote editorial inválido');\nreturn [{json:{...p,id:r.itemId,revisao:r.revision,snapshotKey:r.snapshotKey,originalExecutionId:r.executionId}}];"
      },
      "position": [
        960,
        0
      ]
    },
    {
      "name": "HASH NATIVO - SNAPSHOT ARTIGO",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ JSON.stringify($json.article) }}",
        "dataPropertyName": "checkedArticleHash"
      },
