      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const p=$('VALIDAR SNAPSHOT RECUPERADO').first().json;\nconst expected=$('CONFIGURAR RETOMADA').first().json.publishBaseUrl+'/blog/'+p.article.slug;\nif($json.versionHash!==p.versionHash||$json.slug!==p.article.slug||$json.publicUrl!==expected)throw new Error('Recibo não corresponde ao snapshot aprovado');\nreturn [{json:$json}];"
